{
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:route*",
      "destination": "/api/auth-handler?route=:route*"
    },
    {
      "source": "/api/welcome-auth/:route*",
      "destination": "/api/welcome-handler?route=:route*"
    },
    {
      "source": "/admin/legacy",
      "destination": "/index.html"
    },
    {
      "source": "/research",
      "destination": "/index.html"
    },
    {
      "source": "/research/authors/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/research/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/signin",
      "destination": "/index.html"
    },
    {
      "source": "/welcome",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/unsubscribe",
      "destination": "/index.html"
    },
    {
      "source": "/email-preferences",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/sign-in",
      "destination": "/signin",
      "permanent": true
    }
  ]
}